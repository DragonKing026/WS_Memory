# WS_Memory — konfiguracja. Skopiuj do .env i uzupełnij hasła.
#   cp .env.example .env && ./docker/wygeneruj-sekrety.sh

# --- Baza danych -------------------------------------------------------------
POSTGRES_PASSWORD=zmien-mnie-superuser
MEMPALACE_DB_PASSWORD=zmien-mnie-mempalace
WS_DB_PASSWORD=zmien-mnie-aplikacja
POSTGRES_DB=ws_memory

# --- Pamięć (MemPalace) ------------------------------------------------------
# Token między backendem a mempalace. NIGDY nie trafia do agentów ani do
# przeglądarki — agenci dostają własne tokeny wystawiane w aplikacji.
MEMPALACE_MCP_HTTP_TOKEN=zmien-mnie-token-mcp
MEMPALACE_VERSION=3.7.0

# --- Embeddingi (D-003) ------------------------------------------------------
# UWAGA: zmiana modelu unieważnia WSZYSTKIE wektory w bazie i wymaga
# przeliczenia jej od zera. Nie zmieniaj "przy okazji" aktualizacji.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8

# --- Aplikacja ---------------------------------------------------------------
APP_ENV=dev
APP_SECRET=zmien-mnie-sekret-aplikacji
# Hasło klucza prywatnego JWT. Klucze generuje
#   docker compose exec backend php bin/console lexik:jwt:generate-keypair
JWT_PASSPHRASE=zmien-mnie-haslo-klucza-jwt
BACKEND_TARGET=dev
NGINX_BIND=127.0.0.1
NGINX_PORT=8080

# --- Limity zasobów ----------------------------------------------------------
# Bez limitu kontener weźmie całą pamięć maszyny — serwer embeddingów zajął
# przy pierwszym uruchomieniu ~20 GB. To zabezpieczenie, nie strojenie.
EMBEDDING_MEM_LIMIT=4g
EMBEDDING_CPUS=4
POSTGRES_MEM_LIMIT=2g
MEMPALACE_MEM_LIMIT=2g
BACKEND_MEM_LIMIT=1g
WORKER_MEM_LIMIT=512m
# Rozmiar bufora TEI. Im mniej, tym mniej pamięci; szuflady pałaca to
# fragmenty tekstu, więc 2048 tokenów w partii w zupełności wystarcza.
EMBEDDING_MAX_BATCH_TOKENS=2048
EMBEDDING_MAX_CLIENT_BATCH=8
EMBEDDING_TOKENIZATION_WORKERS=2

# --- Język (D-011) -----------------------------------------------------------
# Domyślnie MemPalace wykrywa encje po angielsku — dla polskiej bazy to za mało.
MEMPALACE_ENTITY_LANGUAGES=pl,en
