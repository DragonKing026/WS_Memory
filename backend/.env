# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Wartość zastępcza. Prawdziwy sekret podaje docker-compose.yml z głównego
# .env, który nie trafia do repozytorium. Repozytorium jest publiczne —
# cokolwiek tu wpiszesz, wpisujesz na widok publiczny.
APP_SECRET=ustaw-w-compose
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# Wartości domyślne dla programisty. Na produkcji i w Dockerze nadpisuje je
# środowisko z docker-compose.yml — hasła nigdy nie mieszkają w tym pliku.
DATABASE_URL="postgresql://ws_app:USTAW_W_COMPOSE@postgres:5432/ws_memory?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Ustawiane przez docker-compose.yml z głównego .env. Sekret nigdy
# nie mieszka w pliku commitowanym do repozytorium.
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> ws-memory ###
# Adres wewnętrzny usługi pamięci (sieć Compose). Nigdy nie wychodzi na zewnątrz.
MEMPALACE_URL=http://mempalace:8765
# Wartość zastępcza. Prawdziwy token podaje docker-compose.yml z głównego .env.
# Repozytorium jest publiczne — cokolwiek tu wpiszesz, wpisujesz publicznie.
MEMPALACE_MCP_HTTP_TOKEN=ustaw-w-compose
# Limit czasu na jedno wywołanie narzędzia pałaca, w sekundach.
MEMPALACE_TIMEOUT=15
# Wersja pałaca PRZYPIĘTA przy budowaniu obrazu (`pip install mempalace==...`).
# To nie to samo co wersja, która odpowiada — tę bierzemy z MCP `initialize`.
# Panel pokazuje obie, bo rozjazd między nimi znaczy „ktoś zmienił .env i nie
# przebudował obrazu".
#
# Wartość zastępcza dla programisty, tak jak MEMPALACE_URL powyżej. Prawdziwą
# podaje docker-compose.yml z głównego .env — dopóki tego nie przekazuje do
# usługi backend, panel pokaże to, co stoi tutaj.
MEMPALACE_VERSION=3.7.0
# Ile wywołań na minutę może wykonać jeden token agenta.
MCP_CALLS_PER_MINUTE=120
###< ws-memory ###

# Wspólna przestrzeń, do której trafia każde nowe konto, i rola, z jaką trafia.
# Pusty slug wyłącza mechanizm — konta dostają wtedy samą przestrzeń prywatną.
WS_DEFAULT_SPACE_SLUG=wiedza
WS_DEFAULT_SPACE_NAME="Baza wiedzy"
WS_DEFAULT_SPACE_ROLE=writer

###> symfony/mailer ###
# Wartość zastępcza: `null` nigdzie nie wysyła i nie zgłasza błędu. Prawdziwy DSN
# podaje docker-compose.yml z głównego .env — ten plik jest w repozytorium
# publicznym, a DSN do SMTP zawiera hasło.
MAILER_DSN=null://null
###< symfony/mailer ###

###> ws-memory: maile ###
# Nadawca wpisywany w nagłówek From każdej wiadomości.
MAIL_FROM=ws-memory@localhost
MAIL_FROM_NAME="Baza wiedzy"
# Publiczny adres, pod którym ludzie widzą aplikację. Z tego budują się linki
# w mailach — zaproszenie z adresem względnym jest bezużyteczne. Puste znaczy
# „nie wiem", i wtedy mail się NIE wysyła: w dzienniku maili pojawia się wpis
# nieudany z tym powodem, zamiast wiadomości z martwym linkiem.
WS_PUBLIC_URL=
###< ws-memory: maile ###
