# Sekrety i środowisko
# Ukośnik na początku jest istotny: bez niego reguła wycina także
# backend/.env, czyli plik z DOMYŚLNYMI wartościami, którego Symfony wymaga
# do startu. Sekrety mieszkają w /.env (compose) i w plikach *.local.
/.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
config/jwt/

# Symfony
/backend/var/
/backend/vendor/
/backend/public/bundles/
/backend/.phpunit.result.cache

# Node / Vue
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/coverage/
*.tsbuildinfo

# Docker i dane lokalne
/docker/data/
*.dump
*.sql

# Kopie zapasowe schematu palace robione przez agenta aktualizacji
# (scripts/aktualizator.sh) wraz z jego plikiem blokady i zachowanymi
# dziennikami. Zrzut bazy nie jest kodem i potrafi mieć setki megabajtów.
/kopie/

# Ślad instalacji: co i kiedy postawił scripts/instaluj.sh, żeby deinstalator
# umiał posprzątać także po instalacji przerwanej w połowie. Stan tej maszyny,
# nie kod — więc do repozytorium nie trafia.
/var/

# Narzędzia i edytory
.idea/
# Zawartość katalogu, a NIE sam katalog: gdy wykluczyć `.vscode/`, git w ogóle
# do niego nie zagląda i wyjątek niżej nigdy nie zadziała.
.vscode/*
# …ten jeden plik dzielimy. Uczy edytor znaczników własnych Symfony
# (`!tagged_iterator`), których ogólny serwer języka YAML nie zna i zgłasza jako
# błąd w pliku, który jest poprawny. Fałszywy alarm jest kosztowny nie dlatego,
# że boli, tylko dlatego, że uczy ignorować listę problemów — a wtedy ginie
# w niej ten prawdziwy.
!.vscode/settings.json
.DS_Store
.notebook/

# Python
__pycache__/
*.pyc

# Zrzuty i dzienniki z przeglądarki użytej do sprawdzania interfejsu — artefakty
# jednego uruchomienia, nie kod.
.playwright-mcp/

# Lokalne ustawienia Claude Code: która wtyczka jest włączona i skąd pochodzi
# jej marketplace. Zależne od maszyny, a poza tym powstaje samo przy instalacji
# wtyczki z tego repozytorium (`plugin/`). Sam token tu nie trafia — Claude Code
# trzyma go w `~/.claude/.credentials.json`, bo `userConfig` ma `sensitive: true`.
.claude/settings.local.json

# Robocze drzewa gita zakładane przez podagentów pracujących równolegle.
# Stan narzędzia, nie projektu — i znika razem z sesją.
.claude/worktrees/
