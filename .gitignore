# Sekrety i środowisko
# Ukośnik na początku jest istotny: bez niego reguła wycina także
# backend/.env, czyli plik z DOMYŚLNYMI wartościami, którego Symfony wymaga
# do startu. Sekrety mieszkają w /.env (compose) i w plikach *.local.
/.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
config/jwt/

# Symfony
/backend/var/
/backend/vendor/
/backend/public/bundles/
/backend/.phpunit.result.cache

# Node / Vue
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/coverage/
*.tsbuildinfo

# Docker i dane lokalne
/docker/data/
*.dump
*.sql

# Narzędzia i edytory
.idea/
.vscode/
.DS_Store
.notebook/

# Python
__pycache__/
*.pyc
